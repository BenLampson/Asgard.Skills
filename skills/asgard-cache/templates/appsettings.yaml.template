caching:
  enabled: true
  # outboxScope: billing-prod  # 可选，同一业务库和缓存范围的副本使用相同值
  redis:
    connectionString: "{ConnectionString}"
    instanceName: "{InstanceName}"
    defaultExpirationMinutes: {DefaultExpirationMinutes}
    database: {Database}
    # streamDatabase: 1  # 可选；省略时与缓存同库
    connectTimeout: 5000
    syncTimeout: 5000
    asyncTimeout: 5000
