host:
  application:
    name: {application_name}
    version: {application_version}
    environment: {environment}
  kestrel:
    endpoints:
      http:
        url: http://*:{port}
  # 静态文件配置
  staticFiles:
    enabled: {static_files_enabled}
    webRootPath: wwwroot
    requestPath: {static_request_path}
    enableDefaultFiles: {enable_default_files}
  # CORS 跨域配置
  cors:
    enabled: {cors_enabled}
    defaultPolicy:
      allowAnyOrigin: {allow_any_origin}
      allowAnyMethod: {allow_any_method}
      allowAnyHeader: {allow_any_header}
      allowCredentials: {allow_credentials}
      preflightMaxAgeSeconds: {preflight_max_age_seconds}
      allowedOrigins:
        {allowed_origins}
  # JWT 认证配置
  auth:
    enabled: {auth_enabled}
    issuer: {issuer}
    audience: {audience}
    key: {signing_key}
    tokenLifetimeMinutes: {token_lifetime}
  # Swagger/OpenAPI 文档
  swagger:
    enabled: {swagger_enabled}
    title: {swagger_title}
    version: {swagger_version}
    description: {swagger_description}
  # 可选 TypeScript 客户端导出，仅 Development 环境生效
  tsGen:
    enabled: false
  # 分层限流：根级字段是当前实例共享总量桶
  rateLimiting:
    enabled: {rate_limiting_enabled}
    policy: FixedWindow
    permitLimit: {permit_limit}
    windowSeconds: {window_seconds}
    queueLimit: 0
    # 可选 IP 层；不需要时删除或保持 enabled: false
    ip:
      enabled: false
      policy: FixedWindow
      permitLimit: {ip_permit_limit}
      windowSeconds: {ip_window_seconds}
      queueLimit: 0
    # 可选用户层；在认证和身份建立后执行
    user:
      enabled: false
      policy: FixedWindow
      permitLimit: {user_permit_limit}
      windowSeconds: {user_window_seconds}
      queueLimit: 0
  # 健康检查
  healthCheck:
    enabled: {health_check_enabled}
    endpoint: {health_check_endpoint}
