host:
  application:
    name: {application_name}
    version: {version}
    environment: {environment}
  kestrel:
    endpoints:
      http:
        url: http://*:{port}
  # 静态文件
  staticFiles:
    enabled: {staticfiles_enabled}
    # webRootPath: wwwroot
    # requestPath: /static
  # CORS 跨域
  cors:
    enabled: {cors_enabled}
    defaultPolicy:
      allowAnyOrigin: true
      allowCredentials: false
      allowAnyMethod: true
      allowAnyHeader: true
      preflightMaxAgeSeconds: 600
  # JWT 认证
  auth:
    enabled: {auth_enabled}
    jwt:
      issuerTemplate: "{issuer_template}"  # 必须包含一个 {tenant}
      audience: {audience}
      requireHttpsMetadata: true
  # OpenAPI 文档和 Scalar 页面
  openApi:
    enabled: {openapi_enabled}
    title: {openapi_title}
    version: {openapi_version}
  # 分层限流：根级字段是当前实例共享总量桶
  rateLimiting:
    enabled: {rateLimiting_enabled}
    policy: FixedWindow
    permitLimit: {permit_limit}
    windowSeconds: {window_seconds}
    queueLimit: 0
    # 可选 IP 层
    ip:
      enabled: false
      policy: FixedWindow
      permitLimit: {ip_permit_limit}
      windowSeconds: {ip_window_seconds}
      queueLimit: 0
    # 可选认证用户层
    user:
      enabled: false
      policy: FixedWindow
      permitLimit: {user_permit_limit}
      windowSeconds: {user_window_seconds}
      queueLimit: 0
  # 健康检查
  healthCheck:
    enabled: {healthCheck_enabled}
    path: {health_check_path}
