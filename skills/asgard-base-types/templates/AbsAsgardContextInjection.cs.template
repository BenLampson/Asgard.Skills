namespace {Namespace}.Services;

/// <summary>通过作用域内的统一入口读取缓存。未启用时按未命中处理。</summary>
public class {ServiceName}Service(AbsAsgardContext context)
{
    public Task<{ResultType}?> ReadCachedAsync(string key, CancellationToken cancellationToken) =>
        context.Redis.Cache.GetAsync<{ResultType}>(key, cancellationToken);
}
